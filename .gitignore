# Secrets — never commit
.env

# User provider config — lives in ~/.tomas/ now (see agent_cli._migrate_providers_config)
providers.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Agent memory (generated)
.agent/

# Third-party tool workspaces
.kilo/

# Install location (if someone installs from repo)
.tomas/

stuff/

# Generated test/report output (regenerated by tests.simulate / pdf_report_skill)
simulation_results.json
cyrillic_results.json
session_audit_*.json
latest_ai_news_report.txt
latest_ai_news_report.pdf

# Ad-hoc analysis notes and plans — summarize into docs/HISTORY.md instead
/*_PLAN.md
/*_REPORT.md
/*_ANALYSIS*.md
/*_FIXES.md

# Generated documents (lab work, exports, scratch output)
*.docx
*.pdf
!docs/**/*.pdf

# Personal Claude Code settings and scratch worktrees
.claude/settings.local.json
.claude/worktrees/

# Throwaway helper scripts the agent writes to carry out a step (agent.SCRATCH_DIR).
# Inside the project because that is the only writable root the sandbox allows.
_scratch/


nextjs-site/
.playwright-mcp/


labwork/
labwork_sessions/
labwork_sessions_v2/
docs/
tests/